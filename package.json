{
  "name": "dsh-ui-taskcards",
  "version": "0.6.2",
  "engines": {
    "node": ">=18.0.0",
    "dsh": ">=0.1.0-rc.8 <0.3.0"
  },
  "description": "DSH web UI right-sidebar todo-task tab: capture todos as durable tasks, schedule, prioritize, sequential run; host tool taskcard_notify lets an agent create a task card preset to another session (client tab + host half)",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "dsh-client",
    "sidebar",
    "task"
  ],
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ydlly224/dsh-ui-taskcards.git"
  },
  "homepage": "https://github.com/ydlly224/dsh-ui-taskcards#readme",
  "bugs": {
    "url": "https://github.com/ydlly224/dsh-ui-taskcards/issues"
  }
}
